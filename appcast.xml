    <item>
      <title>Contrail 0.16.0</title>
      <link>https://github.com/Nkr1shna/contrail-releases/releases/tag/v0.16.0</link>
      <sparkle:version>1172.0</sparkle:version>
      <sparkle:shortVersionString>0.16.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>15.4</sparkle:minimumSystemVersion>
      <pubDate>Thu, 26 Nov 2026 17:52:14 GMT</pubDate>
      <description>&lt;p&gt;Contrail 0.16.0.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Crash reports you send arrive at once, not next launch&lt;/li&gt;&lt;li&gt;Changed: Sync is end-to-end encrypted, even without Advanced Data Protection&lt;/li&gt;&lt;li&gt;Fixed: windows open on a tab after a relaunch&lt;/li&gt;&lt;li&gt;Fixed: undo no longer reopens collapsed folders&lt;/li&gt;&lt;li&gt;Fixed: undo no longer reopens a collapsed pinned section&lt;/li&gt;&lt;li&gt;Send feedback with screenshots from Help or Settings&lt;/li&gt;&lt;li&gt;Fixed iPhone and iPad extension popups saying they can&amp;#x27;t run&lt;/li&gt;&lt;li&gt;Fixed extension popups opening tiny on iPad&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;a href="https://github.com/Nkr1shna/contrail-releases/releases/tag/v0.16.0"&gt;Release notes and download&lt;/a&gt;&lt;/p&gt;</description>
      <enclosure url="https://github.com/Nkr1shna/contrail-releases/releases/download/v0.16.0/Contrail-0.16.0-1172.0.dmg" length="31357224" type="application/x-apple-diskimage" sparkle:edSignature="NR0B0y+i+I6B60QTWoWEiJPXXtbNZcJO52ZdGwbJsW98/EvIJd+3KENXeGlvdygUzKrzOFciM0sRV0r1g3vrDg==" />
      <sparkle:criticalUpdate />
    </item>
    <item>
      <title>Contrail 0.14.0</title>
      <link>https://github.com/Nkr1shna/contrail-releases/releases/tag/v0.14.0</link>
      <sparkle:version>1106.0</sparkle:version>
      <sparkle:shortVersionString>0.14.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>15.4</sparkle:minimumSystemVersion>
      <pubDate>Wed, 25 Nov 2026 20:54:45 GMT</pubDate>
      <description>&lt;p&gt;Contrail 0.14.0.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Clicks on pages that mark themselves draggable work again&lt;/li&gt;&lt;li&gt;New: Mac asks once, after a crash, to send reports&lt;/li&gt;&lt;li&gt;Improved: Contrail checks for updates every hour.&lt;/li&gt;&lt;li&gt;Improved: Critical fixes skip the gradual rollout.&lt;/li&gt;&lt;li&gt;New: import from Edge, Dia, Comet, Vivaldi and Helium&lt;/li&gt;&lt;li&gt;New: Dia&amp;#x27;s Favorites and pinned tabs come with its import&lt;/li&gt;&lt;li&gt;New: Restore Data on iPhone, with Notes, history and settings&lt;/li&gt;&lt;li&gt;Updating ad and tracker blocking lists no longer pauses Contrail.&lt;/li&gt;&lt;li&gt;Fixed: 1Password&amp;#x27;s extension now connects and opens its popup.&lt;/li&gt;&lt;li&gt;Fixed: extensions opening WebSockets in the background no longer freeze.&lt;/li&gt;&lt;li&gt;Fixed: ad blocking now hides ads inside sandboxed frames.&lt;/li&gt;&lt;li&gt;Fixed: extensions can keep WebSockets open in the background.&lt;/li&gt;&lt;li&gt;Extension popups open in empty windows and from Gliders&lt;/li&gt;&lt;li&gt;New: Mac reports freezes and crashes sooner, with your consent&lt;/li&gt;&lt;li&gt;New: Recovery key and device pairing in Settings ▸ Sync&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;a href="https://github.com/Nkr1shna/contrail-releases/releases/tag/v0.14.0"&gt;Release notes and download&lt;/a&gt;&lt;/p&gt;</description>
      <enclosure url="https://github.com/Nkr1shna/contrail-releases/releases/download/v0.14.0/Contrail-0.14.0-1106.0.dmg" length="31086744" type="application/x-apple-diskimage" sparkle:edSignature="vxyajBV+DTPYwYMcIRO8a0six5vUfVMMAcbvTDgGpJYUtxq8sS79h/UaZ6oegEAh7c2TpJS2YwDHmAjbWLZsCg==" />
      <sparkle:criticalUpdate />
    </item>
    <item>
      <title>Contrail 0.13.0</title>
      <link>https://github.com/Nkr1shna/contrail-releases/releases/tag/v0.13.0</link>
      <sparkle:version>974.0</sparkle:version>
      <sparkle:shortVersionString>0.13.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>15.4</sparkle:minimumSystemVersion>
      <pubDate>Wed, 25 Nov 2026 14:40:30 GMT</pubDate>
      <description>&lt;p&gt;Contrail 0.13.0.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;New: Preview, Nightly and Dev have distinct icons.&lt;/li&gt;&lt;li&gt;Fixed: Favorite previews stay open while you reach them.&lt;/li&gt;&lt;li&gt;Failed downloads say why and can be retried.&lt;/li&gt;&lt;li&gt;Fixed: An unreadable library is never saved over.&lt;/li&gt;&lt;li&gt;Settings and About now link to the privacy policy.&lt;/li&gt;&lt;li&gt;After a crash, tabs reopen without loading.&lt;/li&gt;&lt;li&gt;Mac scriptlets no longer fail on one flaky download&lt;/li&gt;&lt;li&gt;The update window shows what changed in each release.&lt;/li&gt;&lt;li&gt;Fixed a crash when an extension opened a second page&lt;/li&gt;&lt;li&gt;Typing in the address bar now closes an open Glance.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;a href="https://github.com/Nkr1shna/contrail-releases/releases/tag/v0.13.0"&gt;Release notes and download&lt;/a&gt;&lt;/p&gt;</description>
      <enclosure url="https://github.com/Nkr1shna/contrail-releases/releases/download/v0.13.0/Contrail-0.13.0-974.0.dmg" length="29852036" type="application/x-apple-diskimage" sparkle:edSignature="W7+SiPuxwKOf27zQDGXSuF/qvKLu6Wppo3GSJFitlGnnXXW3stQaVGZCqkViPZe6hH6THAgZOBqp2lFNd8mDAw==" />
      <sparkle:phasedRolloutInterval>86400</sparkle:phasedRolloutInterval>
    </item>
