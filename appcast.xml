    <item>
      <title>Contrail 0.17.0</title>
      <link>https://github.com/Nkr1shna/contrail-releases/releases/tag/v0.17.0</link>
      <sparkle:version>1229.0</sparkle:version>
      <sparkle:shortVersionString>0.17.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>15.4</sparkle:minimumSystemVersion>
      <pubDate>Fri, 27 Nov 2026 07:32:08 GMT</pubDate>
      <description>&lt;p&gt;Contrail 0.17.0.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Notes open, edit and sync on iPhone and iPad&lt;/li&gt;&lt;li&gt;Canvases now open and edit on iPhone and iPad&lt;/li&gt;&lt;li&gt;Added a Canvases page to the iPhone and iPad Library&lt;/li&gt;&lt;li&gt;Contrail can send its developer one anonymous count a day.&lt;/li&gt;&lt;li&gt;Settings ▸ Anonymous usage counts shows exactly what it sends.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;a href="https://github.com/Nkr1shna/contrail-releases/releases/tag/v0.17.0"&gt;Release notes and download&lt;/a&gt;&lt;/p&gt;</description>
      <enclosure url="https://github.com/Nkr1shna/contrail-releases/releases/download/v0.17.0/Contrail-0.17.0-1229.0.dmg" length="31946590" type="application/x-apple-diskimage" sparkle:edSignature="mmid/vEIjJ2oBGuGlyj6dj3f2BUnY/Ti3VXg1qE27mR6XQdRWSUnaqCPMFEnSNWX9YY2QG4GBP42f4YAnSu8BQ==" />
      <sparkle:criticalUpdate />
    </item>
    <item>
